APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail.
# MAIL_MAILER=zeptomail sends through Zoho ZeptoMail's HTTP API (the block
# below). "log" writes messages to storage/logs instead of sending them,
# which is what you want locally. "smtp" uses MAIL_HOST/PORT/USERNAME.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be an address ZeptoMail has verified for your domain, or Zoho rejects
# every message. The name is what customers see in their inbox.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production hardening — set these on staging and live (see DEPLOY.md)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.in

# Cookies over TLS only. Leave unset on plain-HTTP local work or you cannot
# sign in.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_ENCRYPT=true

# Uploaded files are served host-relative by default, which is correct when the
# document root is public/. Set this only if media sits on another host or CDN.
# FILESYSTEM_PUBLIC_URL=/storage

# Overrides the seeded staff password. Leave unset outside local and the
# seeder generates a strong one and prints it once.
# SEED_ADMIN_PASSWORD=

# Failed admin sign-ins before lockout (also editable in Settings → System).
# ADMIN_LOGIN_THROTTLE=5

# Razorpay. Test keys start rzp_test_, live keys rzp_live_.
# The webhook secret is set in the Razorpay dashboard under Settings → Webhooks.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Zoho ZeptoMail (transactional email).
# Create a Mail Agent in the ZeptoMail console, then copy its Send Mail token
# here. The token Zoho shows already starts with "Zoho-enczapikey"; paste it
# whole. ZOHO_API_URL is the .in endpoint for India-hosted accounts and
# .com for everyone else — using the wrong one returns 401.
ZOHO_MAIL_API_KEY=
ZOHO_MAIL_FROM=
ZOHO_MAIL_FROM_ALIAS=
ZOHO_API_URL=https://api.zeptomail.com/v1.1/email
ZOHO_MAIL_TIMEOUT=15
